/* 分享弹窗永远盖在页面级弹窗（含 .overlay.hi 的完成弹窗，z-index 200）之上 */
.share-overlay { z-index: 300; }

.modal.share { max-width: 380px; max-height: 92vh; overflow-y: auto; }
.share-img {
  width: 100%;
  border: 3px solid var(--ink);
  border-radius: 0;
  box-shadow: 4px 4px 0 rgba(14, 13, 29, .3);
}
.share-loading {
  padding: 60px 0;
  color: var(--ink2);
  font-size: 14px;
}
.share-tip { font-size: 12px; color: var(--ink2); }
/* 保存图纸 / 关闭：从文字链接改成按钮（次级，比上排分享按钮小一号） */
.share-links { display: flex; gap: 10px; }
.share-links > view { flex: 1; }
button.share-fwd {
  align-self: auto;
  padding: 9px 16px;
  line-height: 1.45;
  border-radius: 0;
}
.card-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 750px;
  height: 1200px;
}
