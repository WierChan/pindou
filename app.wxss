/* 拼豆便利店 · 全局样式（奶油淡彩像素风：樱粉×曦黄，玫瑰褐描边 + 方角 + 掉落式硬投影） */
page {
  --bg: #FBF5EC;
  --card: #FFFFFF;
  --ink: #5F4A4E;         /* 玫瑰褐（描边/主文字） */
  --ink2: #A59795;
  --accent: #EABFC3;      /* 樱桃粉（主按钮/进度） */
  --accent-dark: #C9838F;
  --blue: #F2CB8E;        /* 曦黄（激活 Tab；沿用旧变量名少改动） */
  --blue-dark: #C29040;
  --coin: #F5D5D9;        /* 绛羽粉（点缀/徽章） */
  --coin-dark: #C9939F;
  --chipbg: #F7EDE9;
  --line: rgba(95, 74, 78, .16);
  --radius: 0px;
  --shadow: 4px 4px 0 #E2DAD3;

  background: var(--bg);
  /* 像素格子底纹 */
  background-image:
    repeating-linear-gradient(0deg, rgba(95, 74, 78, .06) 0, rgba(95, 74, 78, .06) 1px, transparent 1px, transparent 13px),
    repeating-linear-gradient(90deg, rgba(95, 74, 78, .06) 0, rgba(95, 74, 78, .06) 1px, transparent 1px, transparent 13px);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 15px;
  height: 100%;
}

view, text, image, canvas, input, scroll-view, button {
  box-sizing: border-box;
}

/* 通用按压反馈：像素风按键往右下"按进去" */
.pressed { transform: translate(2px, 2px); }

/* 隐藏的工具画布：用于生成缩略图 / 导出图 / 读取图片像素 */
.util-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 700px;
  height: 900px;
}

/* ============ 内容容器 ============ */
.screen {
  width: 100%;
  max-width: 720px;
  margin: 0 auto;
  padding: 0 16px;
}
@media (min-width: 900px) {
  .screen { max-width: 880px; }
}

/* ============ 顶栏（自定义导航） ============ */
.topbar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding-bottom: 8px;
  position: sticky;
  top: 0;
  z-index: 5;
  background: linear-gradient(var(--bg) 75%, transparent);
}
.tb-back {
  width: 38px;
  height: 38px;
  border-radius: 0;
  background: var(--card);
  border: 3px solid var(--ink);
  box-shadow: 3px 3px 0 #E2DAD3;
  font-size: 22px;
  font-weight: 700;
  line-height: 28px;
  text-align: center;
  flex-shrink: 0;
  transition: transform .12s;
}
.tb-title {
  flex: 1;
  min-width: 0;
  font-weight: 800;
  font-size: 17px;
  letter-spacing: 1px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tb-actions { display: flex; gap: 8px; flex-shrink: 0; }
.icon-btn {
  width: 38px;
  height: 38px;
  border-radius: 0;
  background: var(--card);
  border: 3px solid var(--ink);
  box-shadow: 3px 3px 0 #E2DAD3;
  font-size: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform .12s;
}

/* ============ 通用控件 ============ */
.tabs { display: flex; gap: 10px; }
.tab {
  flex: 1;
  padding: 11px 6px;
  border-radius: 0;
  background: var(--card);
  border: 3px solid var(--ink);
  box-shadow: 3px 3px 0 #E2DAD3;
  font-weight: 700;
  font-size: 15px;
  color: var(--ink2);
  text-align: center;
  transition: transform .12s;
}
.tab.active {
  background: var(--blue);
  color: #7A5A2E; /* 曦黄底配深蜜色字 */
  box-shadow: 3px 3px 0 var(--blue-dark);
}

.btn-primary {
  padding: 14px;
  background: var(--accent);
  color: #7A4A55; /* 淡彩主色配深玫瑰字，不用白字 */
  font-size: 16px;
  font-weight: 800;
  letter-spacing: 2px;
  border: 3px solid var(--ink);
  border-radius: 0;
  box-shadow: 4px 4px 0 var(--accent-dark);
  text-align: center;
  transition: transform .12s;
}
.btn-primary.slim { padding: 10px 22px; font-size: 14px; }
.btn-ghost {
  padding: 9px 16px;
  border-radius: 0;
  background: var(--card);
  border: 3px solid var(--ink);
  box-shadow: 3px 3px 0 #E2DAD3;
  font-weight: 700;
  font-size: 14px;
  align-self: flex-start;
  text-align: center;
  transition: transform .12s;
}
.btn-ghost.slim2 { padding: 10px 18px; align-self: auto; }
.btn-link {
  color: var(--ink2);
  font-size: 13px;
  padding: 6px;
  text-align: center;
}
.b { font-weight: 700; color: var(--ink); }

/* 原生 button 重置（用于 open-type 分享按钮） */
button.btn-reset {
  margin: 0;
  padding: 0;
  background: none;
  border: none;
  line-height: inherit;
  font-size: inherit;
  font-weight: inherit;
  color: inherit;
  border-radius: 0;
}
button.btn-reset::after { border: none; }

/* ============ 拼豆 / 熨烫 / 查看 页面骨架 ============ */
.playpage {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.playpage .topbar {
  padding-left: 16px;
  padding-right: 16px;
  position: relative;
  background: none;
}

.prog-wrap {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 16px 8px;
  max-width: 720px;
  width: 100%;
  margin: 0 auto;
}
.prog-bar {
  flex: 1;
  height: 12px;
  background: var(--card);
  border: 2px solid var(--ink);
  border-radius: 0;
  overflow: hidden;
}
.prog-bar .fill {
  display: block;
  height: 100%;
  width: 0;
  /* 像素分段进度条 */
  background: repeating-linear-gradient(90deg, var(--accent) 0, var(--accent) 8px, #F4DCDF 8px, #F4DCDF 10px);
  border-radius: 0;
  transition: width .25s;
}
.prog-txt {
  font-size: 12px;
  font-weight: 800;
  color: var(--accent-dark);
  min-width: 34px;
  text-align: right;
}

.board-area {
  flex: 1;
  position: relative;
  overflow: hidden;
}
.board {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.zoom-fabs {
  position: absolute;
  right: 12px;
  bottom: 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.zoom-fabs view {
  width: 40px;
  height: 40px;
  border-radius: 0;
  background: var(--card);
  border: 2px solid var(--ink);
  box-shadow: 3px 3px 0 #E2DAD3;
  font-size: 18px;
  font-weight: 700;
  color: var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform .12s;
}

.confetti {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  z-index: 90;
  pointer-events: none;
}

.bottom-bar {
  background: var(--card);
  border-top: 3px solid var(--ink);
  border-radius: 0;
  box-shadow: 0 -4px 0 #F0E5DE;
  padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
}
.bb-inner { max-width: 720px; margin: 0 auto; }

.tools-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 2px 4px 8px;
}
.tool-chip {
  padding: 8px 14px;
  border-radius: 0;
  background: var(--chipbg);
  font-size: 13px;
  font-weight: 700;
  color: var(--ink);
  border: 2px solid var(--ink);
  flex-shrink: 0;
  transition: transform .12s;
}
.tool-chip .b { color: var(--accent-dark); }
.tool-chip.active {
  background: var(--coin);
  box-shadow: 3px 3px 0 var(--coin-dark);
}
.tool-chip.locked { opacity: .6; }
.tools-hint {
  font-size: 12px;
  color: var(--ink2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.palette-bar {
  white-space: nowrap;
  width: 100%;
  padding: 4px 4px 2px;
}
.pchip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  vertical-align: top;
  padding: 5px 6px;
  margin-right: 10px;
  border-radius: 0;
  border: 2px solid rgba(0, 0, 0, 0);
  transition: transform .1s;
}
.pchip.active {
  border-color: var(--ink);
  background: var(--chipbg);
  box-shadow: 3px 3px 0 #E2DAD3;
}
.pchip.done { opacity: .38; }
.pdot {
  width: 34px;
  height: 34px;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 800;
  border: 2px solid var(--ink);
  /* 像素方块的硬斜面高光 */
  box-shadow: inset -3px -3px 0 rgba(0, 0, 0, .16), inset 3px 3px 0 rgba(255, 255, 255, .5);
}
.pcount { font-size: 11px; font-weight: 600; color: var(--ink2); }

.view-bottom {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding-top: 14px;
  flex-wrap: wrap;
  max-width: 720px;
  margin: 0 auto;
}
.view-bottom .tools-hint {
  white-space: normal;
  text-align: center;
  line-height: 1.6;
}

/* ============ 弹窗 ============ */
.overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(95, 74, 78, .45);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn .3s;
  padding: 24px;
}
@keyframes fadeIn { from { opacity: 0; } }
.modal {
  background: var(--card);
  border: 4px solid var(--ink);
  border-radius: 0;
  box-shadow: 6px 6px 0 rgba(95, 74, 78, .3);
  padding: 26px 22px;
  width: 100%;
  max-width: 340px;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 14px;
  animation: popUp .35s cubic-bezier(.2, 1.4, .4, 1);
}
@keyframes popUp { from { transform: scale(.7); opacity: 0; } }
.modal-title { font-size: 22px; font-weight: 800; letter-spacing: 2px; }
.modal-art { display: flex; justify-content: center; }
.modal-sub { color: var(--ink2); font-size: 14px; line-height: 1.7; }
.modal-btns { display: flex; gap: 10px; }
.modal-btns > view, .modal-btns > button { flex: 1; }
