/* 指尖拼豆 · 全局样式（px 布局 + 弹性栅格，手机 / iPad 通用） */
page {
  --bg: #FAF6EF;
  --card: #FFFFFF;
  --ink: #3D3630;
  --ink2: #8C8177;
  --accent: #FF7D54;
  --accent-dark: #E8623A;
  --line: rgba(120, 90, 60, .12);
  --radius: 16px;
  --shadow: 0 4px 16px rgba(120, 90, 60, .10);

  background: var(--bg);
  background-image: radial-gradient(rgba(120, 90, 60, .05) 1.2px, transparent 1.2px);
  background-size: 22px 22px;
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 15px;
  height: 100%;
}

view, text, image, canvas, input, scroll-view, button {
  box-sizing: border-box;
}

/* 通用按压反馈 */
.pressed { transform: scale(.96); }

/* 隐藏的工具画布：用于生成缩略图 / 导出图 / 读取图片像素 */
.util-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 700px;
  height: 900px;
}

/* ============ 内容容器 ============ */
.screen {
  width: 100%;
  max-width: 720px;
  margin: 0 auto;
  padding: 0 16px;
}
@media (min-width: 900px) {
  .screen { max-width: 880px; }
}

/* ============ 顶栏（自定义导航） ============ */
.topbar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding-bottom: 8px;
  position: sticky;
  top: 0;
  z-index: 5;
  background: linear-gradient(var(--bg) 75%, transparent);
}
.tb-back {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: var(--card);
  box-shadow: var(--shadow);
  font-size: 24px;
  line-height: 34px;
  text-align: center;
  flex-shrink: 0;
  transition: transform .12s;
}
.tb-title {
  flex: 1;
  min-width: 0;
  font-weight: 700;
  font-size: 17px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tb-actions { display: flex; gap: 8px; flex-shrink: 0; }
.icon-btn {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: var(--card);
  box-shadow: var(--shadow);
  font-size: 17px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform .12s;
}

/* ============ 通用控件 ============ */
.tabs { display: flex; gap: 10px; }
.tab {
  flex: 1;
  padding: 12px;
  border-radius: 12px;
  background: var(--card);
  box-shadow: var(--shadow);
  font-weight: 600;
  font-size: 15px;
  color: var(--ink2);
  text-align: center;
  transition: transform .12s;
}
.tab.active { background: var(--ink); color: #fff; }

.btn-primary {
  padding: 15px;
  background: var(--accent);
  color: #fff;
  font-size: 16px;
  font-weight: 700;
  border-radius: var(--radius);
  box-shadow: 0 6px 18px rgba(255, 125, 84, .35);
  text-align: center;
  transition: transform .12s;
}
.btn-primary.slim { padding: 11px 22px; font-size: 14px; }
.btn-ghost {
  padding: 10px 16px;
  border-radius: 12px;
  background: var(--card);
  box-shadow: var(--shadow);
  font-weight: 600;
  font-size: 14px;
  align-self: flex-start;
  text-align: center;
  transition: transform .12s;
}
.btn-ghost.slim2 { padding: 11px 18px; align-self: auto; }
.btn-link {
  color: var(--ink2);
  font-size: 13px;
  padding: 6px;
  text-align: center;
}
.b { font-weight: 700; color: var(--ink); }

/* 原生 button 重置（用于 open-type 分享按钮） */
button.btn-reset {
  margin: 0;
  padding: 0;
  background: none;
  border: none;
  line-height: inherit;
  font-size: inherit;
  font-weight: inherit;
  color: inherit;
  border-radius: 0;
}
button.btn-reset::after { border: none; }

/* ============ 拼豆 / 熨烫 / 查看 页面骨架 ============ */
.playpage {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.playpage .topbar {
  padding-left: 16px;
  padding-right: 16px;
  position: relative;
  background: none;
}

.prog-wrap {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 16px 8px;
  max-width: 720px;
  width: 100%;
  margin: 0 auto;
}
.prog-bar {
  flex: 1;
  height: 6px;
  background: #EFE8DB;
  border-radius: 3px;
  overflow: hidden;
}
.prog-bar .fill {
  display: block;
  height: 100%;
  width: 0;
  background: linear-gradient(90deg, #FFAB7B, var(--accent));
  border-radius: 3px;
  transition: width .25s;
}
.prog-txt {
  font-size: 12px;
  font-weight: 700;
  color: var(--ink2);
  min-width: 34px;
  text-align: right;
}

.board-area {
  flex: 1;
  position: relative;
  overflow: hidden;
}
.board {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.zoom-fabs {
  position: absolute;
  right: 12px;
  bottom: 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.zoom-fabs view {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: rgba(255, 255, 255, .92);
  box-shadow: var(--shadow);
  font-size: 18px;
  color: var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform .12s;
}

.confetti {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  z-index: 90;
  pointer-events: none;
}

.bottom-bar {
  background: var(--card);
  border-radius: 20px 20px 0 0;
  box-shadow: 0 -6px 24px rgba(120, 90, 60, .12);
  padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
}
.bb-inner { max-width: 720px; margin: 0 auto; }

.tools-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 2px 4px 8px;
}
.tool-chip {
  padding: 8px 14px;
  border-radius: 999px;
  background: #F7F2E9;
  font-size: 13px;
  font-weight: 700;
  color: var(--ink);
  border: 2px solid rgba(0, 0, 0, 0);
  flex-shrink: 0;
  transition: transform .12s;
}
.tool-chip .b { color: var(--accent-dark); }
.tool-chip.active { border-color: var(--accent); background: #FFF0E8; }
.tool-chip.locked { opacity: .6; }
.tools-hint {
  font-size: 12px;
  color: var(--ink2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.palette-bar {
  white-space: nowrap;
  width: 100%;
  padding: 4px 4px 2px;
}
.pchip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  vertical-align: top;
  padding: 5px 6px;
  margin-right: 10px;
  border-radius: 12px;
  border: 2px solid rgba(0, 0, 0, 0);
  transition: transform .1s;
}
.pchip.active {
  border-color: var(--accent);
  background: #FFF6F1;
  transform: translateY(-2px);
}
.pchip.done { opacity: .38; }
.pdot {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 800;
  border: 1px solid rgba(0, 0, 0, .1);
  box-shadow: inset -2px -3px 6px rgba(0, 0, 0, .12), inset 2px 3px 6px rgba(255, 255, 255, .5);
}
.pcount { font-size: 11px; font-weight: 600; color: var(--ink2); }

.view-bottom {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding-top: 14px;
  flex-wrap: wrap;
  max-width: 720px;
  margin: 0 auto;
}
.view-bottom .tools-hint {
  white-space: normal;
  text-align: center;
  line-height: 1.6;
}

/* ============ 弹窗 ============ */
.overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(60, 45, 30, .45);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn .3s;
  padding: 24px;
}
@keyframes fadeIn { from { opacity: 0; } }
.modal {
  background: var(--card);
  border-radius: 22px;
  padding: 26px 22px;
  width: 100%;
  max-width: 340px;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 14px;
  animation: popUp .35s cubic-bezier(.2, 1.4, .4, 1);
}
@keyframes popUp { from { transform: scale(.7); opacity: 0; } }
.modal-title { font-size: 22px; font-weight: 800; }
.modal-art { display: flex; justify-content: center; }
.modal-sub { color: var(--ink2); font-size: 14px; line-height: 1.7; }
.modal-btns { display: flex; gap: 10px; }
.modal-btns > view, .modal-btns > button { flex: 1; }
