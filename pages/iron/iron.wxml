<view class="ironflow">
  <view class="topbar" style="padding-top:{{insets.top}}px;padding-right:{{insets.right}}px">
    <view class="tb-back" hover-class="pressed" bindtap="goBack">‹</view>
    <view class="tb-title">{{phase === 'pick' ? title : '自动熨烫机'}}</view>
    <view class="tb-actions">
      <view class="fin-tag" wx:if="{{phase !== 'pick'}}">{{finishName}}</view>
      <view class="icon-btn" hover-class="pressed" bindtap="toggleMute"><image class="pxi-l" src="{{muted ? '/assets/icons/sndoff.png' : '/assets/icons/sndon.png'}}" /></view>
    </view>
  </view>

  <!-- 步骤标题 -->
  <view class="fhead">
    <block wx:if="{{phase === 'pick'}}">
      <view class="fkick">READY TO IRON</view>
      <view class="ftitle">选好烫法，开始熨烫</view>
      <view class="fsub">进自动熨烫机：盖布 → 推入 → 压合 → 掀开揭晓。</view>
    </block>
    <block wx:else>
      <view class="fkick">PERLER WORKSHOP</view>
      <view class="ftitle">{{stepT}}</view>
      <view class="fsub">{{stepS}}</view>
    </block>
  </view>

  <view class="stage">
    <!-- 机器（推入 / 压合 时出现） -->
    <view class="machine" wx:if="{{phase === 'insert' || phase === 'press'}}">
      <view class="mled">
        <view class="mdot"></view>
        <text class="mtext">{{ledText}}</text>
        <text class="mlab">PERLER LAB</text>
      </view>
      <view class="mdots">
        <view class="{{phase === 'insert' ? 'on' : ''}}"></view>
        <view class="{{phase === 'press' ? 'on' : ''}}"></view>
        <view></view>
      </view>
      <view class="mmouth"></view>
    </view>
    <view class="marrow" wx:if="{{phase === 'insert'}}">↑</view>

    <!-- 压合进度 -->
    <view class="pressbox" wx:if="{{phase === 'press'}}">
      <view class="pbadge">{{ledText === 'HEAT' ? '正在受热融合…' : '豆豆正在就位…'}}</view>
      <view class="pbar"><view class="pfill" style="width:{{pressPct}}%"></view></view>
    </view>

    <!-- 托盘：一直在 DOM（压合时上移出视野），承载画布 + 烘焙布 -->
    <view class="tray {{phase}} {{trayDrag ? 'dragging' : ''}}" style="transform:translateY(-{{trayLift}}px) scale({{trayScale}});opacity:{{trayOp}}"
          bindtouchstart="onTrayTS" bindtouchmove="onTrayTM" bindtouchend="onTrayTE" bindtouchcancel="onTrayTE">
      <view class="pan" bindtouchstart="onClothTS" bindtouchmove="onClothTM" bindtouchend="onClothTE" bindtouchcancel="onClothTE">
        <canvas type="2d" id="tray" class="traycv" style="width:{{trayW}}px;height:{{trayH}}px"></canvas>
        <view class="cloth {{phase === 'cover' || phase === 'insert' ? 'covered' : ''}} {{phase === 'peel' ? 'peeling' : ''}}"
              style="{{phase === 'peel' ? 'opacity:' + (1 - peelPct/100) + ';transform:translate(' + (peelPct*1.7) + '%,' + (peelPct*1.7) + '%) rotate(' + (peelPct*0.16) + 'deg)' : ''}}"></view>
        <view class="peelgrip" wx:if="{{phase === 'peel'}}">↖</view>
      </view>
    </view>
  </view>

  <!-- 底部 -->
  <view class="fbottom">
    <block wx:if="{{phase === 'pick'}}">
      <view class="fp-label">选择烫法</view>
      <view class="fp-tabs">
        <view wx:for="{{cats}}" wx:key="cat" class="fp-tab {{finishTab === item.cat ? 'on' : ''}}"
              data-cat="{{item.cat}}" bindtap="switchFinishTab">{{item.label}}</view>
      </view>
      <scroll-view scroll-x class="fp-scroll" enhanced show-scrollbar="{{false}}">
        <view class="fp-row">
          <view wx:for="{{cards}}" wx:key="key" class="fp-card {{item.active ? 'on' : ''}}"
                data-f="{{item.key}}" bindtap="pickFinish" hover-class="pressed">
            <image wx:if="{{item.img}}" class="fp-pv" src="{{item.img}}" mode="aspectFit" />
            <view wx:else class="fp-pv ph"></view>
            <view class="fp-nm">{{item.name}}</view>
            <view class="fp-sub">{{item.sub}}</view>
          </view>
        </view>
      </scroll-view>
      <view class="tex-row tex-hole">
        <view class="tex-label">豆孔</view>
        <view class="seg">
          <view class="seg-i {{hole === 'none' ? 'on' : ''}}" hover-class="pressed" data-h="none" bindtap="pickHole">无孔</view>
          <view class="seg-i {{hole === 'small' ? 'on' : ''}}" hover-class="pressed" data-h="small" bindtap="pickHole">小孔</view>
          <view class="seg-i {{hole === 'large' ? 'on' : ''}}" hover-class="pressed" data-h="large" bindtap="pickHole">大孔</view>
        </view>
      </view>
      <view class="start-btn" hover-class="pressed" bindtap="startIron">开始熨烫 →</view>
    </block>
    <view wx:elif="{{phase === 'insert'}}" class="insert-tip" hover-class="pressed" bindtap="doInsert">↑ 手指上滑推入托盘（或点这里）</view>
    <view wx:elif="{{phase === 'peel'}}" class="peel-tip">按住右下角布角，往左上拖，掀开揭晓 ✨</view>
  </view>

  <canvas wx:if="{{celebrating}}" type="2d" id="confetti" class="confetti"></canvas>
  <guide gid="{{guideId}}" steps="{{guideSteps}}" bind:done="onGuideDone" />
</view>

<canvas type="2d" id="util" class="util-canvas" style="width:{{capW}}px;height:{{capH}}px"></canvas>
