/* 熨烫界面：自动熨烫机流程。选烫法横滑器 .fp-* / 分段 .seg 在 app.wxss 全局 */
.ironflow { height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
.ironflow .topbar { padding-left: 16px; padding-right: 16px; position: relative; background: none; }
.fin-tag { padding: 7px 13px; background: var(--card); border: 2px solid var(--ink); box-shadow: 2px 2px 0 #E2DAD3; font-size: 12px; font-weight: 800; color: var(--ink); display: flex; align-items: center; }

/* 步骤标题 */
.fhead { text-align: center; padding: 4px 22px 2px; }
.fkick { font-size: 11px; letter-spacing: 3px; color: var(--ink2); font-weight: 800; }
.ftitle { font-size: 24px; font-weight: 900; color: var(--ink); margin: 4px 0 3px; }
.fsub { font-size: 13px; color: var(--ink2); line-height: 1.5; min-height: 20px; }

/* 舞台 */
.stage { flex: 1; position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; overflow: hidden; }

/* 机器（宽一点更大气；固定高度 = 托盘高度，两块等高；z-index 高于托盘，托盘上滑被机器遮住=吞进去） */
.machine { width: 340px; max-width: 92vw; height: 172px; box-sizing: border-box; display: flex; flex-direction: column; background: linear-gradient(#fff, #f3efe9); border-radius: 24px; padding: 14px 18px 0; box-shadow: 0 12px 30px rgba(120, 100, 80, .18); position: relative; z-index: 3; }
.mled { flex-shrink: 0; background: #1b1b1d; border-radius: 16px; padding: 14px 18px; display: flex; align-items: center; }
.mdot { width: 9px; height: 9px; border-radius: 50%; background: #39d98a; box-shadow: 0 0 8px #39d98a; margin-right: 10px; flex-shrink: 0; }
.mtext { font-size: 21px; font-weight: 900; letter-spacing: 1px; color: #eafff4; flex: 1; }
.mlab { font-size: 10px; letter-spacing: 2px; color: #7d7d82; font-weight: 700; }
.mdots { flex-shrink: 0; display: flex; gap: 6px; justify-content: center; margin-top: 8px; }
.mdots view { width: 22px; height: 5px; border-radius: 3px; background: #e0d8cd; }
.mdots view.on { background: #b8ab9b; }
/* 机身：撑满剩余高度，凹槽面板 + 散热格栅 */
.mbody { flex: 1; margin: 7px 2px; border-radius: 12px; background: rgba(120,100,80,.04); box-shadow: inset 0 1px 4px rgba(120,100,80,.10); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; }
.mvent { width: 52%; height: 4px; border-radius: 3px; background: rgba(120,100,80,.12); }
.mmouth { flex-shrink: 0; height: 22px; background: #1b1b1d; border-radius: 0 0 14px 14px; margin: 0 -18px 0; }

.marrow { font-size: 30px; color: var(--ink); margin: 12px 0; opacity: 0; } /* cover 时隐形但占住间距 */
.marrow.on { opacity: 1; animation: bob 1.1s ease-in-out infinite; }
@keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }

/* 压合进度 */
.pressbox { display: flex; flex-direction: column; align-items: center; margin-top: 16px; }
.pbadge { padding: 6px 14px; background: #fff; border-radius: 20px; font-size: 12px; font-weight: 700; box-shadow: 0 2px 6px rgba(0, 0, 0, .06); }
.pbar { width: 220px; height: 8px; background: #e6ded2; border-radius: 5px; overflow: hidden; margin-top: 14px; }
.pfill { display: block; height: 100%; width: 0; background: linear-gradient(90deg, #F0A24D, #E86A7A); border-radius: 5px; transition: width 2.3s linear; }

/* 托盘 */
.tray { width: 340px; max-width: 92vw; background: #2b2b2d; border-radius: 20px; padding: 14px; box-shadow: 0 12px 26px rgba(80, 60, 50, .2); position: relative; z-index: 1; transition: transform .45s cubic-bezier(.5,0,.2,1), opacity .45s ease; }
.tray.dragging { transition: none; } /* 拖动中跟手，别用过渡 */
/* 画幅：固定高度的框，图案在里面按比例缩放并居中（高矮/宽窄作品框都一样大，不再撑变形） */
.pan { background: #fbf6ec; border-radius: 8px; padding: 10px; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; height: 144px; box-sizing: border-box; }
/* 托盘底部把手（像抽屉拉手，跟着托盘一起进机器） */
.handle { position: absolute; left: 50%; margin-left: -46px; bottom: -13px; width: 92px; height: 18px; background: #2b2b2d; border-radius: 0 0 13px 13px; box-shadow: 0 5px 8px rgba(80,60,50,.18); }
.traycv { display: block; }
/* 烘焙布：光滑半透明烘焙纸（奶白 + 内嵌高光/柔影做出纸的厚度与光泽），底下豆子隐约可见（仿视频） */
.cloth {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-radius: 6px;
  background: rgba(247,241,231,.9); /* 实底奶白，稳稳遮住豆子（渐变在部分渲染器会发虚） */
  box-shadow: inset 0 0 22px rgba(198,180,150,.32), inset 0 4px 6px rgba(255,255,255,.65), inset 0 -12px 18px rgba(255,255,255,.22), 0 1px 3px rgba(120,100,80,.12);
  opacity: 0; transition: opacity .6s;
}
.cloth.covered { opacity: 1; }
/* 烘焙布上的点线边 + 标签（仿参考图，跟布一起掀走） */
.cloth-frame { position: absolute; left: 6px; top: 6px; right: 6px; bottom: 6px; border: 1.5px dotted rgba(150,130,110,.4); border-radius: 4px; }
.cloth-label { position: absolute; left: 0; right: 0; bottom: 7px; text-align: center; font-size: 10px; letter-spacing: 3px; color: rgba(120,100,80,.3); font-weight: 700; }

/* ========= 掀开揭晓大板 ========= */
/* 竖幅拼板：奶棕底 + 圆孔洞（radial-gradient 点阵）像真实拼板，成品居中，四周露孔 */
.peelboard {
  position: relative; width: 322px; max-width: 90vw; height: 402px; max-height: 60vh; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center; border-radius: 16px; overflow: hidden;
  background-color: #e7e0d1;
  background-image: radial-gradient(rgba(120,100,80,.17) 22%, transparent 25%);
  background-size: 13px 13px; background-position: 5px 5px;
  box-shadow: 0 14px 30px rgba(120,100,80,.18), inset 0 0 0 7px #efe9dd, inset 0 0 0 8px rgba(120,100,80,.12);
  animation: boardin .4s ease both;
}
@keyframes boardin { from { opacity: 0; transform: scale(.95); } to { opacity: 1; transform: scale(1); } }
.peelcv { display: block; position: relative; z-index: 1; border-radius: 2px; box-shadow: 0 1px 4px rgba(120,100,80,.14); }
/* 烘焙布正面（平铺部分）：沿对角线裁掉右下三角 → 露出成品 */
.pcloth-face {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0; z-index: 2; background: rgba(247,241,231,.95);
  box-shadow: inset 0 0 28px rgba(198,180,150,.30), inset 0 5px 8px rgba(255,255,255,.6), inset 0 -14px 20px rgba(255,255,255,.2);
  transition: opacity .5s ease;
}
.pcloth-frame { position: absolute; left: 10px; top: 10px; right: 10px; bottom: 10px; border: 1.5px dotted rgba(150,130,110,.4); border-radius: 5px; }
.pcloth-label { position: absolute; left: 0; right: 0; bottom: 12px; text-align: center; font-size: 11px; letter-spacing: 4px; color: rgba(120,100,80,.3); font-weight: 700; }
/* 折起来的布角：露布背面（较浅、细密斜纹），drop-shadow 做折痕立体感 */
.pcloth-flap {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0; z-index: 3; background-color: #f4f0e7;
  background-image: repeating-linear-gradient(45deg, rgba(255,255,255,.75) 0, rgba(255,255,255,.75) 2px, rgba(206,196,180,.55) 2px, rgba(206,196,180,.55) 4px);
  filter: drop-shadow(-2px -2px 4px rgba(90,70,50,.22));
  transition: opacity .5s ease;
}
.pcloth-face.off, .pcloth-flap.off { opacity: 0; } /* 掀完整张布淡出，露成品全貌 */
.peelgrip { position: absolute; right: 12px; bottom: 12px; z-index: 4; width: 32px; height: 32px; border-radius: 50%; background: #E86A7A; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 16px; box-shadow: 0 2px 7px rgba(0,0,0,.22); transition: opacity .2s; animation: grippulse 1.1s ease-in-out infinite; }
@keyframes grippulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.14); } }

/* ========= 手动熨斗 ========= */
.board-area { width: 100%; } /* 全局 .board-area 在居中 stage 里要撑满宽度 */
.mprog { width: 62%; max-width: 260px; height: 8px; margin: 8px auto 0; background: #e6ded2; border-radius: 5px; overflow: hidden; }
.mprog-fill { display: block; height: 100%; width: 0; background: linear-gradient(90deg, #F0A24D, #E86A7A); border-radius: 5px; transition: width .25s; }
.manual-tip { display: flex; align-items: center; justify-content: center; gap: 12px; padding: 10px 16px; flex-wrap: wrap; }
.mt-txt { font-size: 13px; color: var(--ink2); }
.mt-fit { flex-shrink: 0; padding: 7px 14px; font-size: 13px; font-weight: 800; color: var(--ink); background: var(--card); border: 2px solid var(--ink); box-shadow: 2px 2px 0 #E2DAD3; }

/* 底部 */
.fbottom { padding: 6px 12px calc(10px + env(safe-area-inset-bottom)); flex-shrink: 0; }
.start-btn { margin: 10px 4px 2px; padding: 15px; background: var(--accent); color: #7A4A55; font-size: 17px; font-weight: 900; letter-spacing: 2px; border: 3px solid var(--ink); box-shadow: 4px 4px 0 var(--accent-dark); text-align: center; }
.insert-tip { margin: 8px auto; padding: 14px; max-width: 320px; text-align: center; font-size: 15px; font-weight: 800; color: #fff; background: #1b1b1d; border-radius: 16px; }
.peel-tip { text-align: center; font-size: 13px; color: var(--ink2); padding: 12px 20px; }

/* 豆孔行 */
.tex-row { display: flex; align-items: center; justify-content: center; gap: 8px; flex-wrap: wrap; max-width: 720px; margin: 8px auto 0; }
.tex-label { font-size: 12px; color: var(--ink2); flex-shrink: 0; }
