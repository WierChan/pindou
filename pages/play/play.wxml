<view class="playpage">
  <view class="topbar" style="padding-top:{{insets.top}}px;padding-right:{{insets.right}}px">
    <view class="tb-back" hover-class="pressed" bindtap="goBack">‹</view>
    <view class="tb-title">{{title}}</view>
    <view class="tb-actions">
      <view class="icon-btn" hover-class="pressed" bindtap="toggleShape">{{beadShape === 'round' ? '●' : '■'}}</view>
      <view class="icon-btn" hover-class="pressed" bindtap="toggleBgm"><image class="pxi-l" src="{{bgmOn ? '/assets/icons/musicon.png' : '/assets/icons/musicoff.png'}}" /></view>
      <view class="icon-btn" hover-class="pressed" bindtap="toggleMute"><image class="pxi-l" src="{{muted ? '/assets/icons/sndoff.png' : '/assets/icons/sndon.png'}}" /></view>
      <view wx:if="{{debug}}" class="icon-btn" bindtap="debugFill"><image class="pxi-l" src="/assets/icons/bolt.png" /></view>
    </view>
  </view>

  <view class="prog-wrap">
    <view class="prog-bar"><view class="fill" style="width:{{pct}}%" /></view>
    <view class="prog-txt">
      <text class="prog-pct">{{pct}}%</text>
      <text class="prog-left">{{left > 0 ? '还差 ' + left + ' 颗' : '拼齐啦'}}</text>
    </view>
  </view>

  <view class="board-area">
    <canvas type="2d" id="board" class="board"
            bindtouchstart="onTS" bindtouchmove="onTM"
            bindtouchend="onTE" bindtouchcancel="onTE"></canvas>
  </view>

  <view class="bottom-bar">
    <view class="bb-inner">
      <view class="tools-row">
        <view class="tool-chip {{paintOn ? 'active' : ''}}" bindtap="togglePaint"><image class="pxi-s" src="/assets/icons/hand.png" />连续上豆</view>
        <view class="tool-chip fill-chip {{fillArmed ? 'armed' : ''}} {{fillLeft <= 0 ? 'off' : ''}}" hover-class="pressed" bindtap="oneKeyFill"><image class="pxi-s" src="/assets/icons/bolt.png" />一键拼豆 {{fillLeft}}</view>
        <view class="tool-chip fillc-chip {{fillColorLeft <= 0 ? 'off' : ''}}" hover-class="pressed" bindtap="fillColor"><image class="pxi-s" src="/assets/icons/star.png" />拼满此色 {{fillColorLeft}}</view>
        <view class="tr-btns">
          <view class="tr-btn loc {{locateOn ? 'active' : ''}}" hover-class="pressed" bindtap="toggleLocate">◎</view>
          <view class="tr-btn" hover-class="pressed" bindtap="openSwap">🎨</view>
          <view class="tr-btn" hover-class="pressed" bindtap="openResize">📐</view>
          <view class="tr-btn" hover-class="pressed" bindtap="shareMenu"><image class="pxi-l" src="/assets/icons/export.png" /></view>
          <view class="tr-btn" hover-class="pressed" bindtap="zoomFit">⛶</view>
        </view>
      </view>
      <view class="tools-hint row2">{{fillArmed ? '点画板上想拼的位置 → 周围一块向外扩散铺上～' : (paintOn ? '划过格子连续上豆！' : '选颜色点格子上豆 ·「一键拼豆」点哪、哪周围一块都铺上')}}</view>
      <scroll-view class="palette-bar" scroll-x scroll-into-view="{{scrollInto}}"
                   scroll-with-animation enhanced show-scrollbar="{{false}}">
        <view class="pchip {{item.active ? 'active' : ''}} {{item.done ? 'done' : ''}}"
              wx:for="{{chips}}" wx:key="pal" id="c{{item.pal}}"
              bindtap="tapChip" data-pal="{{item.pal}}">
          <view class="pdot" style="background:{{item.hex}};color:{{item.tcol}}">{{item.num}}</view>
          <view class="pcount">{{item.left}}</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <canvas wx:if="{{celebrating}}" type="2d" id="confetti" class="confetti"></canvas>

  <!-- 换色取色器 -->
  <view wx:if="{{swapShow}}" class="swap-mask" bindtap="closeSwap">
    <view class="swap-sheet" catchtap="noop">
      <view class="swap-head">
        <text class="swap-title">把「{{swapFromName}}」换成…</text>
        <text class="swap-x" catchtap="closeSwap">✕</text>
      </view>
      <scroll-view scroll-y class="swap-grid" enhanced show-scrollbar="{{false}}">
        <view class="swap-wrap">
          <view wx:for="{{swapChips}}" wx:key="pal" class="swap-c" style="background:{{item.hex}};color:{{item.tcol}}"
                data-pal="{{item.pal}}" catchtap="pickSwapColor" hover-class="pressed">{{item.code}}</view>
        </view>
      </scroll-view>
      <view class="swap-tip">选一个颜色，整幅图里这个色都会换过去（已拼的豆也跟着变，进度不丢）</view>
    </view>
  </view>

  <!-- 改大小 / 颜色数（从留档原图高质量重生成） -->
  <view wx:if="{{sizeShow}}" class="rz-mask" bindtap="closeResize">
    <view class="rz-sheet" catchtap="noop">
      <view class="swap-head">
        <text class="swap-title">{{rzHasColor ? '改图纸大小 / 颜色数' : '改图纸大小'}}</text>
        <text class="swap-x" catchtap="closeResize">✕</text>
      </view>
      <view class="rz-pv-wrap"><canvas type="2d" id="rzpv" class="rz-pv" style="width:{{rzPvW}}px;height:{{rzPvH}}px"></canvas></view>
      <view class="rz-info">{{rzW}} × {{rzH}} 板 · {{rzTotal}} 颗 · {{rzColorN}} 色</view>
      <view class="rz-row">
        <text class="rz-lab">大小</text>
        <slider class="rz-slider" min="{{rzSizeMin}}" max="{{rzSizeMax}}" value="{{rzSize}}" block-size="20" activeColor="#E86A7A" bindchanging="onRzSize" bindchange="onRzSize" />
        <input class="rz-input" type="number" value="{{rzSize}}" bindblur="onRzSizeInput" bindconfirm="onRzSizeInput" />
      </view>
      <view wx:if="{{rzHasColor}}" class="rz-row">
        <text class="rz-lab">颜色</text>
        <slider class="rz-slider" min="2" max="{{rzColorMax}}" value="{{rzColor}}" block-size="20" activeColor="#E86A7A" bindchanging="onRzColor" bindchange="onRzColor" />
        <input class="rz-input" type="number" value="{{rzColor}}" bindblur="onRzColorInput" bindconfirm="onRzColorInput" />
      </view>
      <view class="rz-warn">⚠ 应用后按新图纸重拼，当前进度会清空{{rzHasColor ? '' : '；这个作品没原图，放大会变糊'}}</view>
      <view class="rz-btns">
        <view class="rz-cancel" hover-class="pressed" bindtap="closeResize">取消</view>
        <view class="rz-apply" hover-class="pressed" bindtap="confirmResize">应用</view>
      </view>
    </view>
  </view>
</view>

<canvas type="2d" id="util" class="util-canvas" style="width:{{capW}}px;height:{{capH}}px"></canvas>

<!-- 完成弹窗：页面顶层 + 提升层级，确保盖住画板 canvas -->
<view wx:if="{{modal.show}}" class="overlay hi">
  <view class="modal">
    <view class="modal-title"><image class="pxi-l" src="/assets/icons/sparkle.png" />豆子拼齐啦！</view>
    <view class="modal-art" wx:if="{{modal.img}}">
      <image src="{{modal.img}}" style="width:{{modal.imgW}}px;height:{{modal.imgH}}px" />
    </view>
    <view class="modal-sub">
      <view>「{{title}}」 · {{total}} 颗豆子 · {{colorN}} 种颜色</view>
      <view>最后一步：亲手把它熨烫定型！</view>
    </view>
    <view class="modal-btns">
      <view class="btn-primary" hover-class="pressed" bindtap="goIron"><image class="pxi" src="/assets/icons/flame.png" />去熨烫</view>
    </view>
    <view class="btn-link" hover-class="pressed" bindtap="goHomeLater">稍后再烫，先回首页</view>
  </view>
</view>

<guide gid="{{guideId}}" steps="{{guideSteps}}" bind:done="onGuideDone" />
