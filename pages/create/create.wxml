<view class="screen create">
  <view class="topbar" style="padding-top:{{insets.top}}px;padding-right:{{insets.right}}px">
    <view class="tb-back" hover-class="pressed" bindtap="goBack">‹</view>
    <view class="tb-title">新作品</view>
  </view>

  <!-- 选择阶段 -->
  <view wx:if="{{mode === 'pick'}}" class="create-body">
    <view class="tabs">
      <view class="tab {{tab === 'image' ? 'active' : ''}}" bindtap="switchTab" data-tab="image"><image class="pxi" src="/assets/icons/camera.png" />图片</view>
      <view class="tab {{tab === 'tpl' ? 'active' : ''}}" bindtap="switchTab" data-tab="tpl"><image class="pxi" src="/assets/icons/bear.png" />图案库</view>
      <view class="tab {{tab === 'free' ? 'active' : ''}}" bindtap="switchTab" data-tab="free"><image class="pxi" src="/assets/icons/pencil.png" />自由画布</view>
    </view>

    <block wx:if="{{tab === 'image'}}">
      <view class="upload-zone" hover-class="uz-hover" bindtap="chooseImage">
        <view class="uz-icon"><image class="pxi-xl" src="/assets/icons/picture.png" /></view>
        <view class="uz-title">选择一张图片</view>
        <view class="uz-sub">照片、表情包、logo 都可以</view>
        <view class="uz-sub">转成拼豆图纸后开拼</view>
      </view>
      <view class="upload-zone uz-chart" hover-class="uz-hover" bindtap="chooseChart">
        <view class="uz-icon"><image class="pxi-xl" src="/assets/icons/chart.png" /></view>
        <view class="uz-title">导入拼豆图纸</view>
        <view class="uz-sub">小红书图纸工坊等生成的图纸截图</view>
        <view class="uz-sub">框出网格 → 自动识别 → 按图纸 1:1 开拼</view>
      </view>
      <view class="code-entry" hover-class="pressed" bindtap="openCodeInput">
        <image class="pxi" src="/assets/icons/key.png" />有导入码？<text class="ce-b">输入口令拼同款</text>
      </view>
    </block>

    <block wx:elif="{{tab === 'free'}}">
      <view class="upload-zone" hover-class="uz-hover" bindtap="startFree">
        <view class="uz-icon"><image class="pxi-xl" src="/assets/icons/pencil.png" /></view>
        <view class="uz-title">开始自由创作</view>
        <view class="uz-sub">无边拼豆板 · 全色板不限量，画到哪算哪</view>
        <view class="uz-sub">完成时自动裁剪成作品，可熨烫、分享、导出</view>
      </view>
    </block>

    <block wx:else>
      <view class="pick-label"><image class="pxi-s" src="/assets/icons/star.png" />新手友好 · 几分钟拼完一幅</view>
      <view wx:if="{{tplError}}" class="pick-label" bindtap="retryTemplates">⚠️ {{tplError}} · 点这里重试</view>
      <view class="tpl-grid">
        <view class="tpl-card" wx:for="{{templates}}" wx:key="name" hover-class="pressed"
              bindtap="pickTpl" data-i="{{index}}">
          <image wx:if="{{item.img}}" class="tpl-img" src="{{item.img}}" mode="aspectFit" />
          <view wx:else class="tpl-img" />
          <view class="tpl-name">{{item.name}} · {{item.count}} 颗</view>
        </view>
      </view>

      <view class="pick-label">😀 表情图案 · 点一个直接转图纸</view>
      <view class="emoji-grid">
        <view class="emoji-btn" wx:for="{{emojis}}" wx:key="*this" hover-class="pressed"
              bindtap="pickEmoji" data-ch="{{item}}">{{item}}</view>
      </view>

      <!-- 流量主 banner（bannerTpl）：只在图案库浏览 tab 底部；位 ID 未下发不渲染，报错即隐藏 -->
      <view wx:if="{{adTpl}}" class="ad-slot">
        <ad unit-id="{{adTpl}}" binderror="onAdTplError"></ad>
      </view>
    </block>
  </view>

  <!-- 配置阶段 -->
  <view wx:else class="create-body">
    <view class="btn-ghost" hover-class="pressed" bindtap="backToPick">‹ 重新选择</view>

    <view class="panel">
      <view class="preview-wrap">
        <canvas type="2d" id="preview" style="width:{{pvW}}px;height:{{pvH}}px"></canvas>
      </view>
      <view class="stats-line">{{dimText}} · <text class="b">{{total}}</text> 颗豆子 · <text class="b">{{colorN}}</text> 种颜色</view>
      <view wx:if="{{fromChart}}" class="chart-hint"><image class="pxi-s" src="/assets/icons/chart.png" />图纸 1:1 还原，颜色与原图纸一致</view>
      <view wx:if="{{importedCode}}" class="code-report" bindtap="reportCode">对这幅图纸有疑问？举报</view>
      <view class="color-chips">
        <view class="cchip" wx:for="{{chips}}" wx:key="index">
          <view class="dot" style="background:{{item.hex}}" />{{item.count}}
        </view>
      </view>

      <block wx:if="{{!fixed}}">
        <view class="opt-col sz-opt">
          <view class="opt-row">
            <view class="opt-label">画布大小</view>
            <view class="opt-val">{{size}} 豆</view>
          </view>
          <view class="size-chips" wx:if="{{sizesShown.length}}">
            <view class="chip {{size === item ? 'active' : ''}}" wx:for="{{sizesShown}}" wx:key="*this"
                  bindtap="setSize" data-n="{{item}}">{{item}} 豆</view>
          </view>
          <slider class="opt-slider" min="{{sizeMin}}" max="{{sizeMax}}" value="{{size}}" step="1"
                  activeColor="#EABFC3" backgroundColor="#F0E4E0" block-size="20"
                  bindchange="onSizeSlider" />
          <view class="opt-hint">{{sizeHint}}</view>
        </view>
        <view class="opt-col cl-opt" wx:if="{{showColor}}">
          <view class="opt-row">
            <view class="opt-label">颜色数量</view>
            <view class="opt-val">{{colorVal}} 色</view>
          </view>
          <slider class="opt-slider" min="2" max="{{colorMax}}" value="{{colorVal}}" step="1"
                  activeColor="#EABFC3" backgroundColor="#F0E4E0" block-size="20"
                  bindchange="onColorSlider" />
        </view>
        <view class="switch-row">
          <view class="sw-label">白色背景不拼豆<text class="sw-small">适合白底图片</text></view>
          <switch checked="{{whiteEmpty}}" color="#EABFC3" bindchange="onWhiteChange" />
        </view>
      </block>

      <view class="name-row">
        <view class="opt-label">作品名</view>
        <input value="{{name}}" maxlength="20" placeholder="给作品起个名字" bindinput="onName" />
      </view>
    </view>

    <view class="btn-primary" hover-class="pressed" bindtap="start">开始拼豆！</view>
  </view>
</view>

<canvas type="2d" id="util" class="util-canvas" style="width:{{capW}}px;height:{{capH}}px"></canvas>
<!-- 图片解码专用画布：与模板缩略图的导出队列分离，选图后立即可用 -->
<canvas type="2d" id="util2" class="util-canvas"></canvas>

<crop-modal show="{{cropShow}}" src="{{cropSrc}}" grid="{{cropGrid}}" init-rect="{{cropInit}}"
            title="{{cropTitle}}" hint="{{cropHint}}"
            bind:confirm="onCropConfirm" bind:cancel="onCropCancel" />

<guide gid="{{guideId}}" steps="{{guideSteps}}" bind:done="onGuideDone" />

<!-- 导入码输入弹窗 -->
<view wx:if="{{codeShow}}" class="overlay hi" bindtap="closeCodeInput">
  <!-- no-anim：原生 input 在带 transform 动画的容器里真机会焦点错位 -->
  <view class="modal no-anim" catchtap="noop">
    <view class="modal-title"><image class="pxi-l" src="/assets/icons/key.png" />输入导入码</view>
    <view class="modal-sub">
      <view>粘贴好友分享的口令（形如 PD-3K7F-9QWW）</view>
    </view>
    <view class="code-input-row">
      <input class="code-input" value="{{codeInput}}" maxlength="14" confirm-type="done"
             focus="{{codeFocus}}" adjust-position cursor-spacing="24"
             placeholder="PD-XXXX-XXXX" bindinput="onCodeInput" bindconfirm="confirmCode" />
      <view class="code-paste" hover-class="pressed" bindtap="pasteCode">粘贴</view>
    </view>
    <view class="modal-btns">
      <view class="btn-primary" hover-class="pressed" bindtap="confirmCode">导入图纸</view>
    </view>
    <view class="btn-link" hover-class="pressed" bindtap="closeCodeInput">取消</view>
  </view>
</view>
