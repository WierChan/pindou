.create-body {
  padding: 16px 0 40px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.upload-zone {
  border: 3px dashed var(--accent);
  border-radius: 0;
  background: rgba(255, 255, 255, .75);
  text-align: center;
  padding: 44px 20px;
  transition: background .15s;
}
.uz-hover { background: #FDECEB; }
.uz-icon { font-size: 40px; }
.uz-title { font-size: 17px; font-weight: 800; letter-spacing: 1px; margin-top: 10px; }
.uz-sub { color: var(--ink2); font-size: 13px; margin-top: 6px; line-height: 1.5; }

/* 图纸导入入口：更矮一点，与主入口区分 */
.uz-chart { margin-top: 14px; padding: 26px 20px; }
.uz-chart .uz-icon { font-size: 32px; }

.chart-hint {
  text-align: center;
  color: var(--ink2);
  font-size: 12.5px;
  margin-top: 6px;
}

.pick-label {
  font-size: 14px;
  font-weight: 700;
  color: var(--ink2);
  margin: 4px 4px -4px;
}

.emoji-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(56px, 1fr));
  gap: 10px;
}
.emoji-btn {
  font-size: 30px;
  line-height: 1;
  padding: 11px 0;
  text-align: center;
  background: var(--card);
  border: 3px solid var(--ink);
  border-radius: 0;
  box-shadow: 3px 3px 0 #E2DAD3;
  transition: transform .1s;
}

.tpl-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;
}
@media (min-width: 560px) {
  .tpl-grid { grid-template-columns: repeat(3, 1fr); }
}
@media (min-width: 900px) {
  .tpl-grid { grid-template-columns: repeat(4, 1fr); }
}
.tpl-card {
  background: var(--card);
  border: 3px solid var(--ink);
  border-radius: 0;
  box-shadow: var(--shadow);
  padding: 16px 12px;
  text-align: center;
  transition: transform .12s;
}
.tpl-img { width: 100%; height: 96px; }
.tpl-name { font-size: 13px; font-weight: 600; margin-top: 8px; color: var(--ink); }

.panel {
  background: var(--card);
  border: 3px solid var(--ink);
  border-radius: 0;
  box-shadow: var(--shadow);
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.preview-wrap { display: flex; justify-content: center; }
.stats-line { text-align: center; color: var(--ink2); font-size: 14px; }

.color-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  justify-content: center;
}
.cchip {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  background: var(--chipbg);
  border: 1.5px solid var(--line);
  padding: 4px 10px 4px 5px;
  border-radius: 0;
  font-size: 12px;
  color: var(--ink2);
}
.cchip .dot {
  width: 16px;
  height: 16px;
  border-radius: 0;
  border: 1.5px solid rgba(95, 74, 78, .35);
}
/* —— 改色 —— */
.recolor-bar { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
.recolor-tip { font-size: 12px; color: var(--ink2); display: flex; align-items: center; }
.recolor-btns { display: flex; gap: 8px; flex-shrink: 0; }
.recolor-btn {
  display: inline-flex; align-items: center;
  padding: 6px 12px; font-size: 13px; font-weight: 700;
  color: var(--ink); background: var(--coin);
  border: 2px solid var(--ink); box-shadow: 2px 2px 0 var(--coin-dark);
}
.recolor-btn.ghost { background: var(--card); box-shadow: 2px 2px 0 #E2DAD3; }
.cchip.edit { border-color: var(--accent-dark); }
.cchip.swapped .dot { border: 2px solid var(--accent-dark); box-shadow: 0 0 0 1.5px #fff inset; }

/* 换色取色器 */
.swap-modal { max-width: 400px; text-align: left; }
.swap-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.swap-cur { display: flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 700; min-width: 0; }
.swap-cur-dot { width: 22px; height: 22px; border: 2px solid var(--ink); flex-shrink: 0; }
.swap-x {
  width: 30px; height: 30px; flex-shrink: 0;
  border: 2px solid var(--ink); box-shadow: 2px 2px 0 #E2DAD3;
  display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700;
}
/* scroll-view 上直接 flex-wrap 真机不认（会竖排）→ 里面包一层普通 view 做换行 */
.swap-scroll { max-height: 46vh; }
.swap-grid { display: flex; flex-wrap: wrap; gap: 6px; padding: 2px; }
.swap-sw { width: 34px; height: 34px; flex-shrink: 0; border: 2px solid rgba(95, 74, 78, .28); }

.opt-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  flex-wrap: wrap;
}
.opt-label { font-size: 14px; font-weight: 600; flex-shrink: 0; }
.opt-col { display: flex; flex-direction: column; gap: 8px; }
.opt-val { font-size: 13px; font-weight: 700; color: var(--accent-dark); display: flex; align-items: center; gap: 3px; }
/* 可手动输入的数字框（画布大小 / 颜色数量）：浅底 + 樱粉描边，示意可点按输入 */
.opt-edit { width: 14px; height: 14px; vertical-align: -2px; }
.opt-input {
  width: 52px;
  min-height: 30px;
  padding: 3px 6px;
  text-align: center;
  font-size: 15px;
  font-weight: 800;
  color: var(--accent-dark);
  background: #FBFAF3;
  border: 2px solid var(--accent);
  border-radius: 0;
}
.opt-hint { font-size: 11px; color: var(--ink2); }
.opt-slider { margin: 2px 4px; }
.size-chips { display: flex; gap: 7px; }
.chip {
  padding: 7px 12px;
  border-radius: 0;
  font-size: 13px;
  font-weight: 600;
  background: var(--chipbg);
  border: 2px solid var(--ink);
  color: var(--ink2);
}
.chip.active {
  background: var(--blue);
  color: #fff;
  box-shadow: 2px 2px 0 var(--blue-dark);
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sw-label {
  font-size: 14px;
  font-weight: 600;
  display: flex;
  flex-direction: column;
}
.sw-small {
  color: var(--ink2);
  font-weight: 400;
  font-size: 12px;
  margin-top: 2px;
}

.name-row { display: flex; align-items: center; gap: 12px; }
.name-row input {
  flex: 1;
  border: 2px solid var(--ink);
  border-radius: 0;
  padding: 10px 12px;
  height: 42px;
  background: #FBFAF3;
}

/* 导入码入口（图片 tab 下方的细条） */
.code-entry {
  text-align: center;
  padding: 12px;
  font-size: 13.5px;
  color: var(--ink2);
  border: 2px dashed rgba(95, 74, 78, .35);
  background: rgba(255, 255, 255, .5);
  transition: transform .12s;
}
.code-entry .ce-b { color: #C9838F; font-weight: 800; }

/* 配置页的举报小链接（口令导入的图纸才显示） */
.code-report {
  text-align: center;
  font-size: 11.5px;
  color: #B7A8A4;
  text-decoration: underline;
  margin-top: -2px;
}

/* 导入码输入弹窗 */
.code-input-row {
  display: flex;
  gap: 10px;
  margin: 10px 0 4px;
}
.code-input {
  flex: 1;
  min-width: 0;
  height: 46px;
  min-height: 46px;
  line-height: 46px;
  padding: 0 12px;
  box-sizing: border-box;
  background: #FFF7F0;
  border: 3px solid var(--ink);
  font-size: 17px;
  font-weight: 800;
  letter-spacing: 2px;
  text-align: center;
}
.code-paste {
  padding: 11px 16px;
  background: var(--blue);
  border: 3px solid var(--ink);
  box-shadow: 3px 3px 0 var(--blue-dark);
  font-size: 14px;
  font-weight: 800;
  display: flex;
  align-items: center;
  transition: transform .12s;
}

.uz-chart .pxi-xl { width: 32px; height: 32px; }
