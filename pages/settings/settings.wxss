.setpage { min-height: 100vh; background: var(--bg); }
.setpage .topbar { padding-left: 16px; background: var(--bg); z-index: 10; }

.set-scroll { padding: 6px 0 40px; }

.set-sec { max-width: 560px; margin: 0 auto 20px; padding: 0 16px; }
.set-sec-t {
  font-size: 13px;
  font-weight: 800;
  color: var(--accent-dark);
  letter-spacing: 1px;
  margin: 0 0 8px 2px;
}
.set-card {
  background: var(--card);
  border: 3px solid var(--ink);
  box-shadow: 4px 4px 0 #E2DAD3;
}
.set-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 10px;
  padding: 12px 14px;
}
.set-row + .set-row { border-top: 2px solid #F0E5DE; }
.set-lb { font-size: 15px; font-weight: 700; color: var(--ink); }
.set-sub { font-size: 11px; font-weight: 400; color: var(--ink2); }

/* 分段控件：一整条描边，内部竖线分隔，选中项樱粉底 */
.seg {
  display: flex;
  border: 2px solid var(--ink);
  overflow: hidden;
  flex-shrink: 0;
}
.seg-i {
  padding: 7px 13px;
  font-size: 13px;
  font-weight: 700;
  color: var(--ink2);
  background: var(--card);
  border-left: 2px solid var(--ink);
  /* 不加 transition：选中即时变色，避免"慢半拍"的错觉 */
}
.seg-i:first-child { border-left: none; }
.seg-i.on { background: var(--coin); color: var(--ink); }

.set-hint { font-size: 12px; color: var(--ink2); line-height: 1.6; margin: 8px 2px 0; }
