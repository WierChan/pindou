.setpage { min-height: 100vh; background: var(--bg); }
.setpage .topbar { padding-left: 16px; background: var(--bg); z-index: 10; }

.set-scroll { padding: 6px 0 40px; }

.set-sec { max-width: 560px; margin: 0 auto 20px; padding: 0 16px; }
.set-sec-t {
  font-size: 13px;
  font-weight: 800;
  color: var(--accent-dark);
  letter-spacing: 1px;
  margin: 0 0 8px 2px;
}
.set-card {
  background: var(--card);
  border: 3px solid var(--ink);
  box-shadow: 4px 4px 0 #E2DAD3;
}
.set-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 10px;
  padding: 12px 14px;
}
.set-row + .set-row { border-top: 2px solid #F0E5DE; }
.set-lb { font-size: 15px; font-weight: 700; color: var(--ink); }
.set-sub { font-size: 11px; font-weight: 400; color: var(--ink2); }

/* 分段控件 .seg/.seg-i 已提到 app.wxss 全局共用（设置 + 熨烫豆孔） */

.set-hint { font-size: 12px; color: var(--ink2); line-height: 1.6; margin: 8px 2px 0; }

/* 烫法多选：整行竖排（标签在上，分组 chip 在下） */
.set-row.col { flex-direction: column; align-items: stretch; }
.set-row.col .set-lb { margin-bottom: 2px; }
.fin-groups { display: flex; flex-direction: column; gap: 10px; }
.fin-cat { font-size: 11px; font-weight: 700; color: var(--accent-dark); letter-spacing: 1px; margin-bottom: 6px; }
.fin-chips { display: flex; flex-wrap: wrap; gap: 8px; }
.fin-chip {
  padding: 7px 12px; font-size: 13px; font-weight: 700;
  color: var(--ink2); background: var(--chipbg);
  border: 2px solid var(--ink);
}
.fin-chip.on { background: var(--coin); color: var(--ink); box-shadow: 2px 2px 0 var(--coin-dark); }
