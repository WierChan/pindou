/* 启动页：奶油像素风便利店开门 */
.splash {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 遮阳棚：粉白条纹 + 玫瑰褐描边 */
.sp-awning {
  height: 22px;
  background: repeating-linear-gradient(90deg, #F5D5D9 0 26px, #FFF7F0 26px 52px);
}

/* 标题 */
.sp-head { text-align: center; margin-top: 34px; }
.sp-h1 { font-size: 40px; font-weight: 900; letter-spacing: 6px; }
.sp-h1 text {
  display: inline-block;
  text-shadow: 3px 3px 0 #E8DCD4;
  animation: h1bob 2.6s ease-in-out infinite;
}
.sp-h1 .c1 { color: #C9838F; animation-delay: 0s; }
.sp-h1 .c2 { color: #C29040; animation-delay: .18s; }
.sp-h1 .c3 { color: #7E9E6B; animation-delay: .36s; }
.sp-h1 .c4 { color: #6E86B0; animation-delay: .54s; }
.sp-h1 .c5 { color: #A9789E; animation-delay: .72s; }
@keyframes h1bob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-3px); }
}
.sp-sub {
  margin-top: 12px;
  color: var(--ink2);
  font-size: 14px;
  letter-spacing: 2px;
}

/* 小场景：店铺站在虚线地平线上 */
.sp-scene {
  flex: 1;
  position: relative;
  margin: 0 24px;
  border-bottom: 2px dashed rgba(95, 74, 78, .28);
}
.sp-sun {
  position: absolute;
  right: 14%;
  top: 12%;
  width: 14px;
  height: 14px;
  background: var(--blue);
  box-shadow: 0 0 0 4px rgba(242, 203, 142, .35);
  animation: suntw 2.4s ease-in-out infinite;
}
@keyframes suntw {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(.72); }
}
.sp-cloud {
  position: absolute;
  left: 10%;
  top: 18%;
  width: 46px;
  height: 14px;
  background: #FFF;
  border: 3px solid var(--ink);
  border-radius: 8px 8px 0 0;
  animation: clouddrift 7s ease-in-out infinite alternate;
}
@keyframes clouddrift {
  from { transform: translateX(0); }
  to { transform: translateX(26px); }
}
.sp-cloud.c2 {
  left: auto;
  right: 8%;
  top: 44%;
  width: 34px;
  height: 11px;
  opacity: .75;
  animation-duration: 9s;
  animation-delay: 1.2s;
}

/* 漂浮的彩色拼豆：方块 + 左上高光 + 中心方孔，错落慢浮 */
.fb {
  position: absolute;
  border: 3px solid var(--ink);
  box-shadow: 2px 2px 0 rgba(95, 74, 78, .15);
  animation: fbfloat 3s ease-in-out infinite alternate;
}
.fb::before {
  content: '';
  position: absolute;
  left: 12%;
  top: 12%;
  width: 24%;
  height: 24%;
  background: rgba(255, 255, 255, .8);
}
.fb::after {
  content: '';
  position: absolute;
  left: 33%;
  top: 33%;
  width: 34%;
  height: 34%;
  background: rgba(35, 33, 58, .26);
}
@keyframes fbfloat {
  from { transform: translateY(-5px); }
  to { transform: translateY(7px); }
}
.fb1 { left: 14%; top: 6%;  width: 22px; height: 22px; background: #EABFC3; animation-duration: 3.2s; }
.fb2 { right: 22%; top: 14%; width: 16px; height: 16px; background: #F2CB8E; animation-duration: 2.6s; animation-delay: .5s; }
.fb3 { left: 32%; top: 30%; width: 18px; height: 18px; background: #A9D4F0; animation-duration: 3.6s; animation-delay: 1s; }
.fb4 { right: 30%; top: 40%; width: 24px; height: 24px; background: #C3A2E6; animation-duration: 2.9s; animation-delay: .3s; }
.fb5 { left: 10%; top: 52%; width: 15px; height: 15px; background: #8FBF87; animation-duration: 3.4s; animation-delay: 1.4s; }
.fb6 { right: 10%; top: 60%; width: 20px; height: 20px; background: #F5D5D9; animation-duration: 2.7s; animation-delay: .8s; }
.fb7 { left: 54%; top: 10%; width: 14px; height: 14px; background: #FF9E9E; animation-duration: 3.1s; animation-delay: 1.8s; }
/* 便利店小房子（复用首页内联 PNG） */
.sp-store {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 112px;
  height: 70px;
  margin-left: -56px;
  background-image: url("data:image/png;base64,");
  background-size: 100% 100%;
  image-rendering: pixelated;
}
/* 门头灯 */
.sp-store::after {
  content: '';
  position: absolute;
  right: 15%;
  top: -10px;
  width: 10px;
  height: 10px;
  background: var(--blue);
  box-shadow: 0 0 8px 3px rgba(242, 203, 142, .8);
  animation: splamp 1.6s steps(1) infinite;
}
@keyframes splamp {
  0%, 100% { opacity: 1; }
  50% { opacity: .25; }
}
.sp-grass { position: absolute; bottom: 0; width: 5px; height: 5px; background: #8FBF87; }
.sp-grass::before { content: ''; position: absolute; left: 5px; top: -5px; width: 5px; height: 10px; background: #8FBF87; }
.sp-grass::after { content: ''; position: absolute; left: 10px; top: 0; width: 5px; height: 5px; background: #8FBF87; }
.g1 { left: 12%; }
.g2 { right: 16%; }
.g3 { left: 30%; opacity: .6; }
.g4 { right: 32%; opacity: .75; }
.g5 { left: 48%; opacity: .5; }

/* 底部进度区 */
.sp-bottom {
  padding: 0 24px calc(34px + env(safe-area-inset-bottom));
}
.sp-track { position: relative; height: 84px; }

/* 豆豆：外层走水平位置（跟随进度），里层跳（挤压拉伸），脚下影子同步缩放 */
.sp-bean {
  position: absolute;
  bottom: 24px;
  left: 24px;
  width: 54px;
  height: 60px;
  transition: left .12s linear;
}
.sp-bean .sprite {
  position: absolute;
  left: 0;
  bottom: 6px;
  width: 54px;
  height: 54px;
  background-image: url("data:image/png;base64,");
  background-size: 100% 100%;
  image-rendering: pixelated;
  animation: sphop .55s cubic-bezier(.36, 0, .64, 1) infinite;
}
.sp-bean .sprite.blink {
  background-image: url("data:image/png;base64,");
}
.sp-bean .shadow {
  position: absolute;
  left: 9px;
  bottom: 0;
  width: 36px;
  height: 6px;
  background: rgba(95, 74, 78, .18);
  border-radius: 50%;
  animation: spshadow .55s cubic-bezier(.36, 0, .64, 1) infinite;
}
@keyframes sphop {
  0%, 100% { transform: translateY(0) scale(1.08, .9); }
  18% { transform: translateY(-2px) scale(.96, 1.05); }
  50% { transform: translateY(-22px) scale(.92, 1.1); }
  82% { transform: translateY(-3px) scale(.98, 1.03); }
}
@keyframes spshadow {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(.55); opacity: .5; }
}
/* 到站落地：停止循环跳，来一个大挤压回弹 */
.sp-bean.landed .sprite {
  animation: spland .52s cubic-bezier(.2, 1.6, .4, 1) forwards;
}
.sp-bean.landed .shadow { animation: none; transform: scale(1.15); }
@keyframes spland {
  0% { transform: translateY(-24px) scale(.9, 1.12); }
  45% { transform: translateY(0) scale(1.28, .72); }
  70% { transform: translateY(-6px) scale(.95, 1.06); }
  100% { transform: translateY(0) scale(1.04, .96); }
}

/* 进度条：像素分段 */
.sp-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 20px;
  background: var(--card);
  border: 3px solid var(--ink);
  box-shadow: 3px 3px 0 rgba(95, 74, 78, .18);
  overflow: hidden;
}
.sp-bar .fill {
  display: block;
  height: 100%;
  background: repeating-linear-gradient(90deg, var(--accent) 0, var(--accent) 10px, #F4DCDF 10px, #F4DCDF 13px);
  transition: width .12s linear;
}

.sp-txt {
  margin-top: 12px;
  text-align: center;
  font-size: 13px;
  font-weight: 700;
  color: var(--ink2);
  letter-spacing: 1px;
}
