.home { padding-bottom: 40px; }

.home-header { text-align: center; padding: 8px 0 20px; }

/* ================= 云朵地平线小场景 ================= */
.px-scene {
  position: relative;
  height: 100px;
  margin: 2px 0 0;
  border-bottom: 2.5px dashed rgba(35, 33, 58, .8); /* 地平线 */
}

/* 像素太阳（104×88 内联 PNG） */
.sun {
  position: absolute;
  right: 18px;
  top: 0;
  width: 46px;
  height: 39px;
  background-image: url("data:image/png;base64,");
  background-size: 100% 100%;
  background-repeat: no-repeat;
  image-rendering: pixelated;
}

/* 圆包像素云（112×56 内联 PNG） */
.cloud {
  position: absolute;
  background-image: url("data:image/png;base64,");
  background-size: 100% 100%;
  background-repeat: no-repeat;
  image-rendering: pixelated;
}
.c1 { left: 12px; top: 16px; width: 84px; height: 42px; animation: drift 9s ease-in-out infinite; }
.c2 { right: 76px; top: 2px; width: 62px; height: 31px; animation: drift 12s ease-in-out infinite reverse; }
@keyframes drift {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(12px); }
}

/* 像素十字星（闪烁） */
.spark { position: absolute; animation: twk 2.4s ease-in-out infinite; }
.spark::before, .spark::after { content: ''; position: absolute; }
.sp1 { width: 12px; height: 12px; left: 36%; top: 30px; }
.sp1::before { left: 4px; top: 0; width: 4px; height: 12px; background: var(--coin); }
.sp1::after { left: 0; top: 4px; width: 12px; height: 4px; background: var(--coin); }
.sp2 { width: 10px; height: 10px; right: 26%; top: 10px; animation-delay: .9s; }
.sp2::before { left: 3.5px; top: 0; width: 3px; height: 10px; background: var(--accent); }
.sp2::after { left: 0; top: 3.5px; width: 10px; height: 3px; background: var(--accent); }
@keyframes twk {
  0%, 100% { transform: scale(1); opacity: .9; }
  50% { transform: scale(.5); opacity: .35; }
}

/* 草丛 */
.grass { position: absolute; bottom: 0; width: 4px; height: 4px; background: #57B96A; }
.grass::before { content: ''; position: absolute; left: 4px; top: -4px; width: 4px; height: 8px; background: #57B96A; }
.grass::after { content: ''; position: absolute; left: 8px; top: 0; width: 4px; height: 4px; background: #57B96A; }
.g1 { left: 11%; }
.g2 { right: 9%; }

/* 落地阴影 */
.gshadow { position: absolute; bottom: 1px; height: 3px; background: rgba(35, 33, 58, .15); }
.gs-m { left: calc(50% - 73px); width: 44px; }
.gs-b { left: calc(50% - 20px); width: 94px; }

/* 吉祥物「豆豆」：站在地平线上，可戳（睁眼/眨眼两帧内联 PNG，16×16 大眼可爱版） */
.mascot {
  position: absolute;
  left: calc(50% - 75px);
  bottom: 0;
  width: 48px;
  height: 48px;
  background-image: url("data:image/png;base64,");
  background-size: 100% 100%;
  background-repeat: no-repeat;
  image-rendering: pixelated;
}
.mascot.blink {
  background-image: url("data:image/png;base64,");
}
.mascot.jump { animation: pjump .5s ease-out; }
.mascot.wobble { animation: pwobble .8s ease-in-out; }
@keyframes pjump {
  0% { transform: translateY(0) scale(1, 1); }
  14% { transform: translateY(3px) scale(1.14, .84); }
  45% { transform: translateY(-20px) scale(.94, 1.1); }
  72% { transform: translateY(0) scale(1.08, .92); }
  100% { transform: translateY(0) scale(1, 1); }
}
@keyframes pwobble {
  0%, 100% { transform: rotate(0); }
  15% { transform: rotate(-14deg); }
  35% { transform: rotate(12deg); }
  55% { transform: rotate(-9deg); }
  75% { transform: rotate(6deg); }
}

/* 三颗方豆 logo：站在地平线上，可弹（像素方豆：方块 + 方孔 + 硬高光） */
.logo-dots {
  position: absolute;
  left: calc(50% - 19px);
  bottom: 2px;
  display: flex;
  gap: 8px;
}
.ld {
  width: 26px;
  height: 26px;
  border-radius: 0;
  border: 3px solid var(--ink);
  position: relative;
  box-shadow: inset 3px 3px 0 rgba(255, 255, 255, .45);
}
.ld.pop { animation: bpop .42s ease-out; }
@keyframes bpop {
  0% { transform: scale(1, 1); }
  30% { transform: scale(1.25, .7) translateY(3px); }
  60% { transform: scale(.85, 1.2) translateY(-7px); }
  100% { transform: scale(1, 1); }
}
.ld-hole {
  position: absolute;
  left: 32%;
  top: 32%;
  right: 32%;
  bottom: 32%;
  border-radius: 0;
}
.ld1 { background: var(--accent); }
.ldh1 { background: var(--accent-dark); }
.ld2 { background: var(--blue); }
.ldh2 { background: var(--blue-dark); }
.ld3 { background: var(--coin); }
.ldh3 { background: var(--coin-dark); }

/* 表情泡 */
.emote {
  position: absolute;
  top: 6px;
  transform: translate(-50%, 0);
  background: #fff;
  border: 2.5px solid var(--ink);
  padding: 2px 8px;
  font-size: 14px;
  font-weight: 800;
  color: var(--ink);
  z-index: 3;
  animation: emoterise .85s ease-out forwards;
}
@keyframes emoterise {
  0% { transform: translate(-50%, 0) scale(.4); opacity: 0; }
  20% { transform: translate(-50%, -8px) scale(1.15); opacity: 1; }
  100% { transform: translate(-50%, -32px) scale(1); opacity: 0; }
}

/* ================= 标题（四个字可跳舞） ================= */
.h1 {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin-top: 14px;
}
.h1c {
  font-size: 30px;
  font-weight: 800;
  text-shadow: 3px 3px 0 rgba(232, 80, 79, .25);
}
.h1.wave .h1c { animation: chb .45s ease-out both; }
.h1.wave .h1c:nth-child(2) { animation-delay: .08s; }
.h1.wave .h1c:nth-child(3) { animation-delay: .16s; }
.h1.wave .h1c:nth-child(4) { animation-delay: .24s; }
@keyframes chb {
  0% { transform: translateY(0); }
  40% { transform: translateY(-11px) scale(1.12); }
  100% { transform: translateY(0); }
}

.h-sub { color: var(--ink2); margin-top: 6px; font-size: 14px; }

.cta-new {
  display: block;
  width: 100%;
  padding: 15px;
  background: var(--accent);
  color: #fff;
  font-size: 17px;
  font-weight: 800;
  letter-spacing: 3px;
  text-align: center;
  border: 3px solid var(--ink);
  border-radius: 0;
  box-shadow: 5px 5px 0 var(--accent-dark);
  transition: transform .12s;
}
.cta-new.pump { animation: pump .4s ease-out; }
@keyframes pump {
  0% { transform: translate(0, 0); }
  30% { transform: translate(3px, 3px); }
  65% { transform: translate(-1px, -1px); }
  100% { transform: translate(0, 0); }
}

.home-tabs { margin-top: 16px; }
.home-list { margin-top: 16px; }

.empty-tip {
  text-align: center;
  color: var(--ink2);
  padding: 48px 20px;
  line-height: 1.9;
  font-size: 15px;
  border: 3px dashed rgba(35, 33, 58, .3);
  border-radius: 0;
  margin-top: 8px;
}

.works-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;
}
@media (min-width: 560px) {
  .works-grid { grid-template-columns: repeat(3, 1fr); }
}
@media (min-width: 900px) {
  .works-grid { grid-template-columns: repeat(4, 1fr); }
}

.work-card {
  background: var(--card);
  border: 3px solid var(--ink);
  border-radius: 0;
  box-shadow: var(--shadow);
  overflow: hidden;
  position: relative;
  transition: transform .12s;
}
.wc-thumb {
  width: 100%;
  padding-top: 100%; /* 1:1，兼容不支持 aspect-ratio 的旧内核 */
  background: #F4F2FB;
  position: relative;
}
.wc-thumb image {
  /* image 组件不支持 width:auto，必须给显式尺寸，否则回退 320×240 被裁切 */
  position: absolute;
  left: 10px;
  top: 10px;
  width: calc(100% - 20px);
  height: calc(100% - 20px);
}
.wc-badge {
  position: absolute;
  left: 8px;
  top: 8px;
  background: #57B96A;
  color: #fff;
  font-size: 11px;
  padding: 3px 8px;
  border: 2px solid var(--ink);
  border-radius: 0;
  font-weight: 700;
}
.wc-badge.iron { background: var(--coin); color: var(--ink); }
.wc-body { padding: 10px 12px 12px; }
.wc-name {
  font-weight: 700;
  font-size: 14px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wc-meta { color: var(--ink2); font-size: 12px; margin-top: 3px; }
.wc-progress {
  height: 10px;
  background: var(--chipbg);
  border: 2px solid var(--ink);
  border-radius: 0;
  margin-top: 8px;
  overflow: hidden;
}
.wc-progress .fill {
  display: block;
  height: 100%;
  /* 像素分段进度条 */
  background: repeating-linear-gradient(90deg, var(--accent) 0, var(--accent) 6px, #F3766F 6px, #F3766F 8px);
  border-radius: 0;
}
.wc-del {
  position: absolute;
  right: 6px;
  top: 6px;
  width: 26px;
  height: 26px;
  border-radius: 0;
  background: var(--card);
  border: 2px solid var(--ink);
  color: var(--ink);
  font-size: 12px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: .92;
}
