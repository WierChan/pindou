<view class="playpage">
  <view class="topbar" style="padding-top:{{insets.top}}px;padding-right:{{insets.right}}px">
    <view class="tb-back" hover-class="pressed" bindtap="goBack">‹</view>
    <view class="tb-title">{{title}}</view>
    <view class="tb-actions">
      <view class="icon-btn" hover-class="pressed" bindtap="delWork">🗑</view>
    </view>
  </view>

  <view class="board-area">
    <canvas type="2d" id="board" class="board"
            bindtouchstart="onTS" bindtouchmove="onTM"
            bindtouchend="onTE" bindtouchcancel="onTE"></canvas>
  </view>

  <view class="bottom-bar view-bottom">
    <view class="tool-chip vt-effect {{fusedOn ? 'active' : ''}}" bindtap="toggleFused">🔥 熨烫效果</view>
    <view class="btn-primary slim vt-share" hover-class="pressed" bindtap="openShare">分享</view>
    <view class="tool-chip vt-code" bindtap="shareCode">🔑 导入码</view>
  </view>

  <share-modal workId="{{workId}}" show="{{shareShow}}" bind:close="closeShare" bind:built="onCardBuilt" />
  <guide gid="{{guideId}}" steps="{{guideSteps}}" bind:done="onGuideDone" />
</view>

<!-- 导入码弹窗：放页面顶层 + 提升层级，确保盖住画板 canvas -->
<view wx:if="{{codeShow}}" class="overlay hi" bindtap="closeCode">
  <view class="modal" catchtap="noop">
    <view class="modal-title">🔑 图纸导入码</view>
    <view class="code-big">{{codeText}}</view>
    <view class="modal-sub">
      <view>复制整段文案发给好友，打开小程序自动识别口令</view>
      <view>也可以手动：新作品 → 输入导入码</view>
    </view>
    <view class="modal-btns">
      <view class="btn-primary" hover-class="pressed" bindtap="copyCode">复制口令</view>
    </view>
    <view class="btn-link" hover-class="pressed" bindtap="closeCode">关闭</view>
  </view>
</view>
